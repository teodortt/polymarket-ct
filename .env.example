# ── Your wallet (копиращ) ──────────────────────────────────────
PRIVATE_KEY=0xyour_private_key_here
# New Polymarket API users (deposit wallet flow): use SIGNATURE_TYPE=3
SIGNATURE_TYPE=3
# Use your Polymarket "API use only" / deposit wallet address here
FUNDER_ADDRESS=0xyour_polymarket_profile_or_deposit_wallet_address

# ── Wallets за следене ─────────────────────────────────────────
# Един:
TARGET_WALLETS=0xwallet_to_copy
# Или много (може да се добавят и през Telegram):
# TARGET_WALLETS=0xwallet1,0xwallet2,0xwallet3

# ── Telegram ───────────────────────────────────────────────────
# 1. Създай бот от @BotFather -> вземи TOKEN
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
# 2. Вземи chat ID от @userinfobot или @getmyid_bot
TELEGRAM_CHAT_ID=123456789

# ── Trading config ─────────────────────────────────────────────
HOST=https://clob.polymarket.com
POLL_INTERVAL_MS=10000
COPY_SIZE_USDC=0
SIZE_MULTIPLIER=1.0
MAX_TRADE_USDC=100
MIN_TRADE_USDC=1
DRY_RUN=true
DRY_RUN_START_USDC=1000
ORDER_TYPE=GTC
RPC_URL=https://polygon-rpc.com

# ── WARP Proxy (Cloudflare WARP в proxy режим на VPS) ─────────
# Остави празно за да деактивираш
PROXY_URL=

# Weather
WEATHER_ENABLED=true          # Module is OFF by default
WEATHER_LOOKAHEAD_DAYS=3
WEATHER_MIN_LEAD_DAYS=0       # Allow same-day markets (lead 0)
WEATHER_SAME_DAY_CUTOFF_HOUR=16 # Stop opening new same-day bets after local 16:00
WEATHER_CITIES=               # Empty = all discovered cities
WEATHER_KELLY_FRACTION=0.25
WEATHER_BANKROLL_USDC=0       # 0 = auto (dry-run start / live USDC)
WEATHER_MAX_TRADE_USDC=20
WEATHER_MIN_TRADE_USDC=1
WEATHER_MIN_PRICE=0.01        # Won't buy below 1¢ (default 1¢)
WEATHER_MAX_PRICE=0.97        # Won't buy above 97¢ (default 97¢)
WEATHER_MIN_LIQUIDITY_USDC=160 # Skip illiquid buckets (default 150)
WEATHER_MAX_LIQUIDITY_FRACTION=0.02  # Won't take >2% of bucket's depth
WEATHER_MIN_HOURS_TO_RESOLVE=0 # Discovery filter (trade-time gate uses local cutoff)
WEATHER_SPREAD_INFLATION=1.1  # Ensemble variance inflation (default 1.1)
WEATHER_KDE_BANDWIDTH_F=2.0   # Kernel smoothing width in °F (default 2°F)
WEATHER_KDE_LEAD_PER_DAY_F=0.25 # Uncertainty growth per lead day (default 0.25)
WEATHER_DETERMINISTIC_WEIGHT=0.6
WEATHER_DISAGREEMENT_SIGMA_WEIGHT=0.6
WEATHER_SCAN_INTERVAL_MS=600000  # Every 10min (default)
WEATHER_MIN_EDGE=0.06            # Minimum edge to place a trade (default 6%)
WEATHER_MAX_TRADES_PER_SCAN=6     # Max 6 trades per scan (default 6)
WEATHER_MAX_TRADES_PER_DAY=30      # Daily cap (default 30)
WEATHER_MODELS=gfs_seamless,icon_seamless,ecmwf_ifs025  # Ensemble members
