# ── Your wallet (копиращ) ──────────────────────────────────────
PRIVATE_KEY=0xyour_private_key_here
# New Polymarket API users (deposit wallet flow): use SIGNATURE_TYPE=3
SIGNATURE_TYPE=3
# Use your Polymarket "API use only" / deposit wallet address here//
FUNDER_ADDRESS=0xyour_polymarket_profile_or_deposit_wallet_address

# ── Wallets за следене ─────────────────────────────────────────
# Един:
TARGET_WALLETS=0xwallet_to_copy
# Или много (може да се добавят и през Telegram):
# TARGET_WALLETS=0xwallet1,0xwallet2,0xwallet3

# ── Telegram ───────────────────────────────────────────────────
# 1. Създай бот от @BotFather -> вземи TOKEN
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
# 2. Вземи chat ID от @userinfobot или @getmyid_bot
TELEGRAM_CHAT_ID=123456789

# ── Trading config ─────────────────────────────────────────────
# Set to false to disable copy-trading entirely (weather-only mode).
# Useful when you have no TARGET_WALLETS or just want weather trading.
COPY_ENABLED=false
POLL_INTERVAL_MS=10000
COPY_SIZE_USDC=0
SIZE_MULTIPLIER=1.0
MAX_TRADE_USDC=100
MIN_TRADE_USDC=1
DRY_RUN=false
DRY_RUN_START_USDC=1000
ORDER_TYPE=GTC
# Optional Polygon RPC for signing/chain reads (defaults to https://polygon-rpc.com)
# RPC_URL=https://polygon-rpc.com

# ── WARP Proxy (Cloudflare WARP в proxy режим на VPS) ─────────
# Остави празно за да деактивираш
PROXY_URL=

# Weather
WEATHER_ENABLED=true          # Module is OFF by default
WEATHER_SCAN_INTERVAL_MS=600000  # Every 10min (default)
WEATHER_LOOKAHEAD_DAYS=3
WEATHER_CITIES=
WEATHER_MIN_EDGE=0.08         # Flow recovery: keep positive-edge requirement but avoid over-filtering
WEATHER_KELLY_FRACTION=0.25
WEATHER_BANKROLL_USDC=0       # 0 = auto (dry-run start / live USDC)
WEATHER_MAX_TRADE_USDC=2
WEATHER_MIN_TRADE_USDC=1
WEATHER_MAX_LIQUIDITY_FRACTION=0.04  # Allow up to 4% of bucket depth
WEATHER_MIN_LIQUIDITY_USDC=150  # Allow thinner books
WEATHER_MIN_PRICE=0.01       # Flow recovery: admit 1c+ while still rejecting 0.1c dust
WEATHER_MAX_PRICE=0.995       # Allow richer entries (up to 99.5¢)
WEATHER_MAX_MARKET_FAVORITE_PROB=0.995 # Flow recovery: disable disagreement hard block (monitor quality)
WEATHER_MIN_MODE_PROB=0.08    # Flow recovery: slightly looser mode-confidence gate
WEATHER_MIN_MODE_GAP=0        # Flow recovery: disable tie-gap blocker
WEATHER_MAX_DET_ENSEMBLE_GAP_C=6.0 # Flow recovery: tolerate volatile same-day structure
WEATHER_MIN_HOURS_TO_RESOLVE=0 # Discovery filter only (trade-time guard is same-day cutoff)
WEATHER_MIN_LEAD_DAYS=0       # 0 = allow same-day (lead 0) markets; 1 = skip them
WEATHER_SAME_DAY_CUTOFF_HOUR=24 # Skip same-day trades once city local hour >= this (high locked); 24 = all day
WEATHER_KDE_BANDWIDTH_F=2.0   # Kernel smoothing width in °F (default 2°F)
WEATHER_KDE_LEAD_PER_DAY_F=0.25 # Uncertainty growth per lead day (default 0.25)
WEATHER_SPREAD_INFLATION=1.1  # Ensemble variance inflation (default 1.1)
WEATHER_DETERMINISTIC_WEIGHT=0.6
WEATHER_DISAGREEMENT_SIGMA_WEIGHT=0.6
WEATHER_MODELS=gfs_seamless,icon_seamless,ecmwf_ifs025  # Ensemble members
WEATHER_SETTLE_YES_THRESHOLD=0.9
WEATHER_BIAS_EMA_ALPHA=0.5
WEATHER_BIAS_MIN_SAMPLES=2
WEATHER_MIN_CITY_BIAS_SAMPLES_TO_TRADE=0 # 0 disables; >0 trades only calibrated cities
WEATHER_MAX_CITY_BIAS_C=6
WEATHER_MAX_BANKROLL_FRACTION_PER_EVENT=0.035
WEATHER_LOCK_MIN_PROB=0.98
WEATHER_LOCK_MAX_ASK=0.95
WEATHER_BACKTEST_SIGMA_FLOOR=true
WEATHER_BACKTEST_MIN_SAMPLES=20
# Module 1 — Resolution research (build the store with `npm run weather:research`).
# The store is ALWAYS surfaced in reports; this guard only gates trades when true.
WEATHER_RESOLUTION_GUARD=true        # true = skip markets flagged high dispute-risk
# Module 5/6 — Calibration kill switch (build the report with `npm run weather:score`).
WEATHER_CALIBRATION_KILL_SWITCH=false # bootstrap default: do not hard-stop entries while model is learning
WEATHER_CALIBRATION_MIN_SCORED=30      # require more resolved trades before judging health
WEATHER_CALIBRATION_MAX_LOSS_ROI=-0.35 # stricter stop only after material drawdown
WEATHER_MAX_TRADES_PER_SCAN=10    # Max 10 trades per scan
WEATHER_MAX_TRADES_PER_DAY=80     # Daily cap

# Weather exit/profit-taking (new)
WEATHER_EXIT_ENABLED=true       # Auto-exit positions based on P&L (default false)
WEATHER_EXIT_PROFIT_TARGET=2.10 # Exit at 75% profit (default 0.75)
WEATHER_EXIT_STOP_LOSS=-0.15    # Exit at 30% loss (default -0.30)
WEATHER_EXIT_MIN_HOURS_HELD=1   # Min hours to hold before exiting (default 1)
WEATHER_EXIT_SCAN_INTERVAL_MS=60000  # Check exits every 60s (default 60000)
WEATHER_EXIT_TREND_ENABLED=false      # Enable trend-down protective exit (default false)
WEATHER_EXIT_TREND_DROP_FROM_PEAK=0.08 # Exit if profit drops 8% from peak (default 0.08)
WEATHER_EXIT_TREND_MIN_PROFIT=0.05     # Apply trend-exit only after >=5% profit (default 0.05)
