{
  "name": "polymarket-copybot",
  "version": "2.0.0",
  "description": "Polymarket copy-trading bot with Telegram management",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "ts-node-dev --respawn src/index.ts",
    "test:copy-one": "node scripts/testCopyOne.js",
    "weather:scan": "ts-node src/weather/cli.ts",
    "weather:obs": "ts-node src/weather/obsCli.ts"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "socks-proxy-agent": "^10.0.0",
    "telegraf": "^4.16.3",
    "viem": "^2.47.17"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
